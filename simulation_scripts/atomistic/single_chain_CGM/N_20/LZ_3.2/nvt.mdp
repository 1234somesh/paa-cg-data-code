integrator = md
dt = 0.001
nsteps = 300000000

nstenergy = 5000
nstlog = 5000
nstxout-compressed = 1000
compressed-x-grps = non-Water

constraint-algorithm = lincs
constraints = none
continuation = no
periodic-molecules = yes

tcoupl = v-rescale
tau_t = 0.1
ref_t = 300
tc_grps = system

;pcoupl = Berendsen
;Pcoupltype = semiisotropic
;nstpcouple = -1
;tau_p = 2.0
;compressibility = 4.5e-5 0
;ref_p = 1.0 0 

comm-mode = linear

cutoff-scheme = Verlet
verlet-buffer-tolerance = 0.005   ; More flexibility in cut-off calculations
nstlist = 2

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype              = PME
coulomb-modifier         = None
rcoulomb-switch          = 0
rcoulomb                 = 1.2  ; Adjusted for half-box compatibility
rlist                    = 1.2
epsilon-r                = 1
epsilon-rf               = 0

fourierspacing           = 0.12

vdw-type                 = Cut-off
vdw-modifier             = None
rvdw-switch              = 0
rvdw                     = 1.2  ; Adjusted to avoid exceeding the half-box limit

