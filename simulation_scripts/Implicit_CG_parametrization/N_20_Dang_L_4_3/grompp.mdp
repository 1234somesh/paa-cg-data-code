i; VARIOUS PREPROCESSING OPTIONS
; Preprocessor - specify a full path if necessary.

integrator               = md
; Start time and timestep in ps
tinit                    = 0
dt                       = 0.00005
nsteps                   = 20000000
comm-mode                = Linear
nstlog                   = 1000
nstenergy                = 1000
nstxout-compressed       = 1000
compressed-x-precision   = 5000
energygrps               = M NA 
nstlist                  = 10
pbc                      = xyz
rlist                    = 2.12
rcoulomb                 = 2.12
coulombtype              = cutoff
vdwtype                  = user
rvdw-switch              = 0.0
rvdw                     = 2.12
table-extension          = 0.0
energygrp_table          = M NA NA NA M M
fourierspacing           = 0.12
pme_order                = 4
ewald_rtol               = 1e-04
ewald_geometry           = 3d
epsilon_surface          = 0

tcoupl                   = yes
tc-grps                  = system
tau_t                    = 1.0
ref_t                    = 298
;gen_vel                  = yes

;pcoupl                   = Parrinello-Rahman
;pcoupltype               = isotropic
;tau_p                    = 1.0
;ref_p                    = 1.0
;compressibility          = 4.5e-5

; OPTIONS FOR BONDS
constraints              = all-bonds
constraint_algorithm     = shake
Shake-SOR                = no

cutoff-scheme = Group
