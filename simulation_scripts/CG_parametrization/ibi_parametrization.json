{
  "description": "Iterative Boltzmann inversion (IBI) of the non-bonded CG pair potentials of PAA with Na+, K+ or Cs+ counterions (and Cl- co-ions with added salt). Paths are relative to this file.",
  "how_to_run": {
    "command": "cd <path>; ./run_ibi.sh <LAST_STEP>",
    "requires": [
      "LAMMPS (lmp in PATH)",
      "Python 3 with NumPy and Matplotlib",
      "step_01/ with in.lmp and updated_potentials/"
    ],
    "each_iteration": [
      "lmp -in in.lmp  (pair tables from ../step_<i-1>/updated_potentials/; writes rdf_<pair>.dat)",
      "python3 ../ibi.py  (IBI update of the pairs in pairs_updated; others copied)",
      "python3 ../fit_short_range.py  (replaces the unsampled short-range core of each updated table by a smooth repulsive wall; script in <path>)",
      "python3 ../shift_to_zero.py --rcut 20.0  (potential shifted to zero at the cutoff)"
    ]
  },
  "ibi": {
    "update": "U_new(r) = U_old(r) + prefactor * kB*T * ln(g_CG(r) / g_target(r)),  r <= r_cut_corr",
    "prefactor": 0.04,
    "temperature_K": 300.0,
    "g_floor": 1e-06,
    "r_cut_corr_angstrom": 20.0,
    "initial_potentials": "<path>/initial/ (PMF-derived short-range potentials; bonded tables from Boltzmann inversion)",
    "targets": "<path>/targets/<pair>.dist.dat (atomistic RDFs, r in nm)",
    "convergence": "merit function of the RDFs, merit.py (where present)"
  },
  "lammps": {
    "units": "real (r in Angstrom, energy in kcal/mol)",
    "box_nm": 6.0,
    "N_monomers": 20,
    "pair_style": "hybrid/overlay table linear 2000 coul/long 20.0",
    "kspace": "pppm 1.0e-4",
    "thermostat": "Nose-Hoover NVT, T = 300 K, T_damp = 10 fs",
    "timestep_fs": 5.0,
    "run_length_per_iteration": "see runs[].run_length_per_iteration_ns"
  },
